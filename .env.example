# ================================================================
# Moo Desk — Variables de Entorno (Opcionales)
# Copia este archivo como .env o .env.local para personalizar valores.
# Moo funciona perfectamente sin este archivo utilizando sus valores por defecto.
# ================================================================

# Puerto del servidor backend local de Moo (por defecto: 8000)
MOO_BACKEND_PORT=8000

# URL del backend consumida por el cliente web/Tauri
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000/api

# Servidor Ollama local para modelos de lenguaje opcionales
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Proveedores de IA externos (opcionales: si no se configuran, Moo opera 100% offline y local)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
